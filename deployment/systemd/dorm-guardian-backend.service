[Unit]
Description=Dorm Guardian FastAPI Backend
After=network.target

[Service]
User=tru3
WorkingDirectory=/home/tru3/dorm-guardian/dorm-guardian/backend
Environment=USE_PICAMERA2=true
Environment=CAMERA_ENABLED=true
ExecStart=/home/tru3/dorm-guardian/dorm-guardian/backend/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
